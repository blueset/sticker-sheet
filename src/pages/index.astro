---
import "../styles/global.css";
import interLatin from "@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url";
import cjkFontsCss from "../styles/cjk-fonts.css?url";
import Sticker from "../components/Sticker.astro";
import Controls from "../islands/Controls";
import Sheet from "../islands/Sheet";
import { bundleInline } from "../inline/bundle";
import { variantCss, variantPlan } from "../lib/lang-css";
import { LANGS, type Lang } from "../lib/localize";
import { prerenderContent } from "../lib/mdx/prerender";
import { loadStickers } from "../lib/stickers";
import shadowVariantsCss from "../styles/shadow-variants.css?raw";

const stickers = loadStickers();

// `{"<slug>":{"<lang>":["expr0", …]}}`, read by boot-view to fill `[data-live]` nodes.
const liveExprs: Record<string, Record<string, string[]>> = {};
const contentHtml = new Map<string, Partial<Record<Lang, string>>>();

for (const sticker of stickers) {
  const html: Partial<Record<Lang, string>> = {};
  for (const lang of variantPlan(sticker.content).has) {
    const rendered = await prerenderContent(sticker.slug, lang);
    html[lang] = rendered.html;
    if (rendered.exprs.length > 0) (liveExprs[sticker.slug] ??= {})[lang] = rendered.exprs;
  }
  contentHtml.set(sticker.slug, html);
}

// `<` is escaped so no expression can close the script element.
const liveJson = JSON.stringify(liveExprs).replace(/</g, "\\u003c");

const [bootHead, bootFonts, bootView] = await Promise.all([
  bundleInline("boot-head"),
  bundleInline("boot-fonts"),
  bundleInline("boot-view"),
]);
// Tuning builds only (PUBLIC_VARIANTS=1): sets html[data-v-*] before first paint.
const bootVariants = process.env.PUBLIC_VARIANTS === "1" ? await bundleInline("boot-variants") : null;
const variantStyles = process.env.PUBLIC_VARIANTS === "1" ? shadowVariantsCss : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sticker sheet</title>
    <meta name="description" content="Eana’s sticker sheet" />
    <link rel="icon" href="/favicon.ico" />
    <script is:inline set:html={bootHead}></script>
    {bootVariants && <script is:inline set:html={bootVariants}></script>}
    <script is:inline data-href={cjkFontsCss} set:html={bootFonts}></script>
    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />
    <style is:inline set:html={variantCss(LANGS)}></style>
    {variantStyles && <style is:inline set:html={variantStyles}></style>}
  </head>
  <body class="antialiased overflow-hidden h-dvh w-dvw">
    <div class="h-dvh w-dvw overflow-hidden relative">
      <div id="canvasWrapper">
        <div id="canvas" class="bg-grid-png">
          {stickers.map((sticker) => <Sticker sticker={sticker} contentHtml={contentHtml.get(sticker.slug) ?? {}} />)}
        </div>
        <script is:inline type="application/json" id="live-exprs" set:html={liveJson}></script>
        <script is:inline set:html={bootView}></script>
      </div>
      <Controls client:idle />
      <Sheet client:idle />
    </div>
    <script>
      import "../viewer/main.ts";
    </script>
  </body>
</html>
