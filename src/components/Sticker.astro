---
import { webpSibling } from "../../scripts/optimize-assets";
import type { BoxManifest, ShadowManifest } from "../../scripts/gen-shadows";
import shadowBoxes from "../data/shadow-boxes.json";
import shadowSprites from "../data/shadows.json";
import { isInitialViewport, stickerBox, stickerCenter } from "../lib/geometry";
import { variantPlan } from "../lib/lang-css";
import type { Lang } from "../lib/localize";
import { publicFiles } from "../lib/public-files";
import type { StickerRecord } from "../lib/stickers";

interface Props {
  sticker: StickerRecord;
  // Prerendered content markup per language (see `prerenderContent`).
  contentHtml: Partial<Record<Lang, string>>;
}

const { sticker, contentHtml } = Astro.props;

const box = stickerBox(sticker);
const center = stickerCenter(sticker);
const content = variantPlan(sticker.content);
const title = variantPlan(sticker.title);
// A zero-area sticker is a hidden test fixture, not something to focus or announce.
const hidden = box.width === 0 || box.height === 0;
// Raster stickers get a WebP source when `npm run optimize-assets` wrote one; the img stays the fallback.
const webp = sticker.image ? webpSibling(sticker.image, publicFiles()) : null;
const imgProps = {
  src: sticker.image,
  width: box.width,
  height: box.height,
  alt: "",
  decoding: "async",
  loading: "eager",
  fetchpriority: isInitialViewport(sticker) ? "high" : "low",
} as const;

// Shadow candidates (`?v=shadow:s1|s2`) need per-sticker data; only tuning
// builds (PUBLIC_VARIANTS=1) emit it, so the default markup is unchanged.
const variants = process.env.PUBLIC_VARIANTS === "1";
const sprite = variants ? (shadowSprites as ShadowManifest)[sticker.slug] : undefined;
const boxRadius = variants ? ((shadowBoxes as BoxManifest)[sticker.slug]?.radius ?? null) : null;

const style = [
  `left:${box.left}px`,
  `top:${box.top}px`,
  `width:${box.width}px`,
  `height:${box.height}px`,
  sticker.rotation ? `rotate:${sticker.rotation}deg` : "",
  `contain-intrinsic-size:${box.width}px ${box.height}px`,
  sprite ? `--shadow:url(/shadows/${sticker.slug}.webp?h=${sprite.hash.slice(0, 8)});--shadow-pad:${sprite.pad}px` : "",
  boxRadius !== null ? `--box-radius:${boxRadius}px` : "",
]
  .filter(Boolean)
  .join(";");
---

<button
  type="button"
  class="sticker"
  style={style}
  data-slug={sticker.slug}
  data-cx={center.x}
  data-cy={center.y}
  data-titles={JSON.stringify(sticker.title)}
  data-has={content.has.join(" ")}
  data-sprite={sprite ? "" : undefined}
  data-box={boxRadius !== null ? "" : undefined}
  tabindex={hidden ? -1 : undefined}
  aria-hidden={hidden ? "true" : undefined}
>
  <span class="clip" style={sticker.clipPath ? `clip-path:${sticker.clipPath}` : undefined} aria-hidden="true" data-has={content.has.join(" ")}>
    {
      sticker.image &&
        (webp ? (
          <picture>
            <source type="image/webp" srcset={webp} />
            <img {...imgProps} />
          </picture>
        ) : (
          <img {...imgProps} />
        ))
    }
    {
      content.has.map((lang) => (
        <div data-l={lang} data-fb={lang === content.fallback ? "" : undefined} set:html={contentHtml[lang]} />
      ))
    }
  </span>
  <span class="sr-only" data-title-group data-has={title.has.join(" ")}>
    {
      title.has.map((lang) => (
        <span data-l={lang} data-fb={lang === title.fallback ? "" : undefined}>
          {sticker.title[lang]}
        </span>
      ))
    }
  </span>
</button>
